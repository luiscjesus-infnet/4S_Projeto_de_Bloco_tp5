# Copie este arquivo para .env (que fica fora do Git) e preencha.
# Sem .env o projeto funciona do mesmo jeito: o assistente usa o modelo local.

# ---------------------------------------------------------------- motor do assistente
# local = Qwen2.5-1.5B rodando nesta máquina | api = serviço externo configurado abaixo
MOTOR_PADRAO=local

# ---------------------------------------------------------------- serviço externo (opcional)
# Qualquer serviço compatível com o formato de chat da OpenAI (POST {URL}/chat/completions).
# Exemplos de endereço:
#   OpenRouter: https://openrouter.ai/api/v1        (tem modelos gratuitos, com limite de uso)
#   OpenAI:     https://api.openai.com/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_URL=https://openrouter.ai/api/v1
LLM_API_CHAVE=
# nome do modelo exatamente como o serviço escreve (no OpenRouter, os gratuitos terminam em ":free")
LLM_API_MODELO=
# modelos que "pensam" antes de responder gastam tokens raciocinando; com pouco, a resposta vem vazia
LLM_API_MAX_TOKENS=1500
LLM_API_TEMPO_LIMITE=60

# ---------------------------------------------------------------- modelo local (opcional)
# MODELO_LLM=Qwen/Qwen2.5-1.5B-Instruct
# LLM_DISPOSITIVO=auto
# LLM_PRECISAO=float32
